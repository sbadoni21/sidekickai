# ===== Required (free-tier API runtime) =====
GROQ_API_KEY=your_groq_api_key

# ===== STT runtime (free-tier defaults) =====
STT_PROVIDER=puter
STT_PROVIDER_CHAIN=puter,groq
STT_ALLOW_GOOGLE_FALLBACK=false
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Choose a text model available to your Groq project.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_PUTER_REQUEST_TIMEOUT_MS=22000

# ===== Optional paid STT upgrade =====
# ELEVENLABS_API_KEY=your_elevenlabs_api_key
# STT_PROVIDER=elevenlabs
# STT_PROVIDER_CHAIN=elevenlabs,puter,groq

# ===== Optional tuning =====
STT_STREAM_FLUSH_INTERVAL_MS=300
STT_MAX_QUEUE_CHUNKS=120
STT_MAX_FLUSH_CHUNKS_PER_TICK=6
STT_CHUNK_FALLBACK_WINDOW_MS=2500
STT_CHUNK_FALLBACK_MIN_WINDOW_MS=1200
STT_CHUNK_FALLBACK_MAX_BUFFER_MS=9000
STT_MAX_RECONNECT_ATTEMPTS=6
STT_RECONNECT_BASE_DELAY_MS=350
STT_RECONNECT_MAX_DELAY_MS=6000

# ===== Build-time renderer vars (bundled into app) =====
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_DB_URL=https://your-project.supabase.co
VITE_UPSTASH_VECTOR_REST_URL=https://your-upstash-vector-url
VITE_UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token
VITE_STT_PROVIDER=puter
VITE_STT_PROVIDER_CHAIN=puter,groq
